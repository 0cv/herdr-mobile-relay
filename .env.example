# Checkout-only settings used by Makefile web targets.
WEB_PROJECT=herdr-mobile-relay
# WEB_BRANCH=main

# Optional for non-interactive `make web-deploy` authentication. Keep the
# ignored `.env` file at mode 0600 when storing a token.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Relay runtime settings do not belong here. Setup writes them to relay/.env
# for a checkout or the persistent Herdr plugin config for an installation.
# The hybrid transport settings that file accepts, for reference:
#
#   HERDR_GATEWAY_URL=              Blind WSS gateway base URL, for example
#                                   wss://gw.example.com. Empty (the default)
#                                   keeps the Cloudflare tunnel path; setting it
#                                   makes Quick Start skip cloudflared entirely.
#                                   Self-hosting: docs/gateway-self-hosting.md.
#   HERDR_GATEWAY_SELECTION=ordered How the relay picks among healthy gateways.
#                                   ordered (the default) takes the first
#                                   healthy HERDR_GATEWAY_URL entry in
#                                   configured order; latency keeps the
#                                   lowest-latency healthy entry. Setup writes
#                                   latency only for the community list.
#   HERDR_WEBRTC_UDP_PORT=0         Fixed UDP port for the direct WebRTC path.
#                                   0 (default) picks an ephemeral port.
#   HERDR_TRANSPORT_FORCE_RELAY=0   Test flag: 1 disables the direct WebRTC
#                                   upgrade and keeps every frame on the
#                                   gateway path. Default 0.
#   HERDR_REACHABILITY_PORT_MAPPING=1
#                                   Ask the router for a UPnP/NAT-PMP mapping
#                                   for the WebRTC port, raising direct-path
#                                   success. Default 1; set 0 to never talk to
#                                   the router.
