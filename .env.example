# Checkout-only settings used by Makefile web targets.
WEB_PROJECT=herdr-mobile-relay
# WEB_BRANCH=main

# Optional for non-interactive `make web-deploy` authentication. Keep the
# ignored `.env` file at mode 0600 when storing a token.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Relay runtime settings do not belong here. Setup writes them to relay/.env
# for a checkout or the persistent Herdr plugin config for an installation.
