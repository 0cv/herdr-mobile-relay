  "type": "module",
  "version": "0.0.0",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": "24.21.0"
  },
  "scripts": {
    "lint": "eslint .",
    "check": "tsc --noEmit",
