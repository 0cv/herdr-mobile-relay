--- a/relay/common.sh
+++ b/relay/common.sh
@@ -1076,11 +1076,32 @@
 }
 
 json_bool_field() {
-    local json="$1"
-    local key="$2"
-    printf '%s\n' "$json" |
-        tr -d ' \t\n' |
-        sed -n "s/.*\"$key\":\(true\|false\).*/\1/p" |
+    local json="${1:-}"
+    local key="${2:-}"
+    local compact_json
+
+    case "$key" in
+        ''|*[!A-Za-z0-9_]*) return 1 ;;
+    esac
+
+    compact_json="$(printf '%s\n' "$json" | tr -d ' \t\n')" || return 1
+    case "$compact_json" in
+        \{*\}) ;;
+        *) return 1 ;;
+    esac
+    if printf '%s\n' "$compact_json" |
+        sed -n "s/.*\"$key\":.*\"$key\":.*/duplicate/p" |
+        grep -q .; then
+        return 1
+    fi
+
+    # Use independent POSIX BRE matches; \| is a GNU sed extension. The Go
+    # inspector supplies complete JSON; this narrow accessor handles literal
+    # field names and exact booleans rather than parsing arbitrary JSON.
+    printf '%s\n' "$compact_json" |
+        sed -n \
+            -e "s/.*[,{]\"$key\":true[,}].*/true/p" \
+            -e "s/.*[,{]\"$key\":false[,}].*/false/p" |
         head -1
 }
 
--- a/tests/test_common.sh
+++ b/tests/test_common.sh
@@ -564,6 +564,40 @@
 test "$(gateway_registration_state '{"gateway": {"enabled": true, "registered": false}}')" = "false"
 test -z "$(gateway_registration_state '{"status":"ok"}')"
 
+# Exercise the boolean accessor with POSIX sed mode on Linux. Darwin uses its
+# native BSD sed and must not receive GNU-only command-line options.
+BOOL_SED_PATH="$PATH"
+case "$(uname -s)" in
+    Linux)
+        REAL_SED="$(command -v sed)"
+        if ! "$REAL_SED" --posix -n '' </dev/null; then
+            echo "Linux boolean-field regression requires sed --posix" >&2
+            exit 1
+        fi
+        BOOL_SED_DIR="$WORK_DIR/posix-sed"
+        mkdir -p "$BOOL_SED_DIR"
+        printf '#!/bin/sh\nexec "%s" --posix "$@"\n' "$REAL_SED" > "$BOOL_SED_DIR/sed"
+        chmod 700 "$BOOL_SED_DIR/sed"
+        BOOL_SED_PATH="$BOOL_SED_DIR:$PATH"
+        ;;
+    Darwin) ;;
+esac
+json_bool_field_with_test_sed() (
+    PATH="$BOOL_SED_PATH"
+    json_bool_field "$@"
+)
+
+BOOL_SIBLINGS='{"enabled":true,"disabled":false}'
+test "$(json_bool_field_with_test_sed "$BOOL_SIBLINGS" enabled)" = true
+test "$(json_bool_field_with_test_sed "$BOOL_SIBLINGS" disabled)" = false
+test -z "$(json_bool_field_with_test_sed '{"enabled":true}' missing)"
+test -z "$(json_bool_field_with_test_sed '{"enabled":"true","sibling":false}' enabled)"
+test -z "$(json_bool_field_with_test_sed '{"enabled":1,"sibling":true}' enabled)"
+test -z "$(json_bool_field_with_test_sed '{"message":"escaped \"enabled\":true"}' enabled)"
+test -z "$(json_bool_field_with_test_sed '{"enabled":true' enabled)"
+test -z "$(json_bool_field_with_test_sed '{"enabled":tru}' enabled)"
+test -z "$(json_bool_field_with_test_sed '{"enabled":true,"enabled":true}' enabled)"
+
 # The setup fragment carries only gateways=<ordered list> for a
 # gateway-configured relay and relay=<wss url> otherwise. Both keep the token
 # inside the fragment.
@@ -1032,6 +1066,11 @@
 EOF
