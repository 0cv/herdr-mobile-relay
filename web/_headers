/* Stable bootstrap and metadata are deliberately revalidated. Only
 * digest-addressed build entries and assets may be stored indefinitely. */
/herdr-bootstrap.js
  Cache-Control: no-cache, no-store

/manifest-loader.js
  Cache-Control: no-cache, no-store

/manifest.webmanifest
  Cache-Control: no-cache, no-store

/setup.webmanifest
  Cache-Control: no-cache, no-store

/sw.js
  Cache-Control: no-cache, no-store

/version.json
  Cache-Control: no-cache, no-store

/release.json
  Cache-Control: no-cache, no-store

/
  Cache-Control: no-cache, no-store

/index.html
  Cache-Control: no-cache, no-store

/builds/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
