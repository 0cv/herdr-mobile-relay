{
  "name": "herdr-mobile-relay-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun scripts/compress-assets.mjs dist && bun scripts/validate-build.mjs dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:attention": "playwright test --config playwright.attention.config.ts",
    "test:browser:release": "HERDR_WEB_ROOT=../web playwright test",
    "size": "bun scripts/check-size.mjs dist"
  },
  "dependencies": {
    "svelte": "5.56.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
