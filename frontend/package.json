{
  "name": "herdr-mobile-relay-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.2",
    "node": "24.21.0"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun scripts/finalize-build.mjs dist && bun scripts/compress-assets.mjs dist && bun scripts/validate-build.mjs dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:attention": "bash scripts/run-attention-tests.sh",
    "test:browser:release": "HERDR_WEB_ROOT=../web playwright test",
    "size": "bun scripts/check-size.mjs dist"
  },
  "dependencies": {
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
